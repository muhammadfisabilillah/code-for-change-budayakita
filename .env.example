# Supabase project credentials (public, safe to expose in the browser).
# Without these, the app falls back to bundled seed data in lib/seed.ts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only credentials for `npm run seed`.
# The seeder writes to the database, so it needs the service-role key, which
# bypasses Row Level Security. NEVER expose this value in browser code.
# Leave blank if you only want to run the app against the bundled seed data.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
