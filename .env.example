# Neon (primary database)
# Get this from Neon dashboard > Connection string (pooled is fine).
# When empty, the app uses the bundled seed data in lib/seed.ts.
DATABASE_URL=

# Legacy Supabase adapter (optional, no longer used by default).
# Keep blank unless you explicitly switch back to scripts/seed.ts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
